FROM php:8.4-fpm-alpine3.20 AS build

RUN apk --no-cache add \
  libzip-dev \
  git

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Installer les extensions PHP
RUN docker-php-ext-install mysqli pdo_mysql zip
RUN docker-php-ext-enable mysqli pdo_mysql zip

# Créer un utilisateur non-root pour la sécurité
RUN addgroup -g 1000 ogspy && adduser -u 1000 -G ogspy -s /bin/sh -D ogspy

WORKDIR /var/www/html
COPY . .

# Installer les dépendances Composer
RUN composer install --prefer-dist --no-progress --no-dev --optimize-autoloader

# Configuration des permissions plus sécurisée
RUN chown -R ogspy:ogspy /var/www/html \
    && chmod -R 755 /var/www/html \
    && chmod -R 775 /var/www/html/cache /var/www/html/logs /var/www/html/config

EXPOSE 9000

COPY .docker/start.sh /start.sh

RUN chmod +x /start.sh

# Utiliser l'utilisateur non-root
USER ogspy

ENTRYPOINT ["/start.sh"]
