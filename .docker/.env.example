# Copy this file to .env and replace sample values before deployment.
# Required secrets:
MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_PASSWORD=change-this-app-password

# Optional overrides:
MARIADB_DATABASE=ogspy
MARIADB_USER=ogspy
OGSPY_HTTP_PORT=16005
OGSPY_DB_HOST=db
OGSPY_TABLE_PREFIX=ogspy_

# Installer lock behavior:
# Enabled by default to block web installer after automatic first-run install.
OGSPY_LOCK_INSTALL_ON_START=true

# Non-interactive first-run install (CLI installer):
OGSPY_AUTO_INSTALL_ON_START=true
OGSPY_ADMIN_USER=ogsteam
OGSPY_ADMIN_PASSWORD=ogsteam
OGSPY_ADMIN_EMAIL=
