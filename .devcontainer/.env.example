# Variables d'environnement pour OGSpy DevContainer
# Copiez ce fichier en .env et modifiez selon vos besoins

# Configuration de la base de données
DB_HOST=db
DB_USER=ogspy
DB_PASSWORD=password
DB_NAME=ogspy
DB_PREFIX=ogspy_

# Configuration du compte administrateur
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Configuration du développement
OPEN_BROWSER=true

# Pour la production, utilisez des valeurs sécurisées :
# DB_PASSWORD=un_mot_de_passe_fort
# ADMIN_PASSWORD=un_mot_de_passe_admin_fort
# ADMIN_EMAIL=votre_email@domaine.com
